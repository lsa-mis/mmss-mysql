<% content_for :title, 'Forgot your password?' %>
<h1 class="mb-1 text-lg font-semibold text-slate-900">Forgot your password?</h1>
<p class="mb-4 text-sm text-slate-600">Enter your admin email and we will send you a link to reset it.</p>

<%= admin_form_with model: resource, scope: resource_name, url: password_path(resource_name), method: :post, class: 'grid gap-4' do |f| %>
  <%= f.errors_summary %>
  <%= f.input :email, as: :email, autofocus: true, autocomplete: 'email', required: true %>
  <%= f.button 'Send me reset password instructions', class: 'admin-btn-primary w-full justify-center' %>
<% end %>

<%= render 'admins/shared/links' %>
