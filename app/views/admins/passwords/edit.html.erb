<% content_for :title, 'Change your password' %>
<h1 class="mb-4 text-lg font-semibold text-slate-900">Change your password</h1>

<%= admin_form_with model: resource, scope: resource_name, url: password_path(resource_name), method: :put, class: 'grid gap-4' do |f| %>
  <%= f.errors_summary %>
  <%= f.hidden_field :reset_password_token %>

  <%= f.input :password, as: :password, label: 'New password', autofocus: true, autocomplete: 'new-password', required: true,
                         hint: ("#{@minimum_password_length} characters minimum" if @minimum_password_length) %>
  <%= f.input :password_confirmation, as: :password, label: 'Confirm new password', autocomplete: 'new-password', required: true %>

  <%= f.button 'Change my password', class: 'admin-btn-primary w-full justify-center' %>
<% end %>

<%= render 'admins/shared/links' %>
