<% admin_page_title 'Campnotes', subtitle: "#{number_with_delimiter(@pagy.count)} #{'note'.pluralize(@pagy.count)}" %>
<% admin_page_actions do %>
  <%= admin_csv_link %>
  <%= link_to 'New Campnote', new_admin_campnote_path, class: 'admin-btn-primary' %>
<% end %>

<div class="grid gap-5 xl:grid-cols-4">
  <div class="xl:col-span-3">
    <%= admin_table @campnotes, pagy: @pagy,
                    batch_actions: Admin::CampnotesController::BATCH_ACTIONS, batch_url: batch_admin_campnotes_path,
                    actions: ->(note) { [admin_campnote_path(note), edit_admin_campnote_path(note), admin_campnote_path(note)] } do |t| %>
      <% t.column :id, sort: true do |note| %>
        <%= link_to note.id, admin_campnote_path(note), class: 'font-medium' %>
      <% end %>
      <% t.column :note, sort: true do |note| %>
        <span class="block max-w-md truncate" title="<%= note.note %>"><%= note.note %></span>
      <% end %>
      <% t.column 'Open date', sort: 'opendate', &:opendate %>
      <% t.column 'Close date', sort: 'closedate', &:closedate %>
      <% t.column 'Note type', sort: 'notetype' do |note| %>
        <%= admin_campnote_type_badge(note.notetype) %>
      <% end %>
      <% t.column 'Visible now' do |note| %>
        <%= admin_boolean(admin_campnote_visible?(note)) %>
      <% end %>
      <% t.column :created_at, sort: true %>
      <% t.column :updated_at, sort: true %>
    <% end %>
  </div>

  <div class="xl:col-span-1">
    <%= admin_filter_form @filter, url: admin_campnotes_path %>
  </div>
</div>
