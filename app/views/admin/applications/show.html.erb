<% applicant_name = @application.applicant_detail&.full_name&.titleize || @application.user.email %>
<% admin_page_title "Application ##{@application.id}", subtitle: "#{applicant_name} · #{@application.campyear} camp" %>
<% admin_page_actions do %>
  <% case @application.application_status %>
  <% when 'application complete' %>
    <%= button_to 'Place on Wait List', waitlist_admin_application_path(@application), method: :post, class: 'admin-btn-secondary',
                  form: { data: { turbo_confirm: 'Are you sure you want to wait list this application?' } } %>
    <%= admin_legacy_link_to 'Reject Applicant', new_legacy_admin_rejection_path(enrollment_id: @application.id), class: 'admin-btn-secondary' %>
  <% when 'waitlisted' %>
    <%= button_to 'Remove from Wait List', remove_from_waitlist_admin_application_path(@application), method: :post, class: 'admin-btn-secondary',
                  form: { data: { turbo_confirm: 'Are you sure you want to remove this application from wait list?' } } %>
  <% when 'enrolled' %>
    <%= button_to 'Withdraw Enrollment', withdraw_admin_application_path(@application), method: :post, class: 'admin-btn-danger',
                  form: { data: { turbo_confirm: 'Are you sure you want to withdraw this enrollment? This will delete all associated course assignments.' } } %>
  <% end %>
  <%= link_to 'Edit', edit_admin_application_path(@application), class: 'admin-btn-primary' %>
  <%= button_to 'Delete', admin_application_path(@application), method: :delete, class: 'admin-btn-danger',
                form: { data: { turbo_confirm: 'Delete this application? This cannot be undone.' } } %>
<% end %>

<div class="grid gap-5 xl:grid-cols-3">
  <div class="grid gap-5 xl:col-span-2">
    <%= admin_panel 'Application', body_class: '' do %>
      <%= admin_attributes @application do |a| %>
        <% a.row 'Applicant' do |app| %>
          <% if app.applicant_detail %>
            <%= admin_legacy_link_to app.applicant_detail.full_name.titleize, legacy_admin_applicant_detail_path(app.applicant_detail) %>
          <% end %>
          <span class="text-slate-500"><%= app.user.email %></span>
        <% end %>
        <% a.row(:uniqname) if @application.application_status == 'enrolled' %>
        <% a.row :personal_statement do |app| %>
          <p class="admin-prose"><%= app.personal_statement %></p>
        <% end %>
        <% a.row :notes do |app| %>
          <p class="admin-prose"><%= app.notes.presence || admin_empty_value %></p>
        <% end %>
        <% a.row :offer_status do |app| %><%= admin_status_badge(app.offer_status) %><% end %>
        <% a.row :application_deadline %>
        <% a.row :application_status do |app| %><%= admin_status_badge(app.application_status) %><% end %>
        <% a.row :application_status_updated_on, :camp_doc_form_completed, :partner_program, :application_fee_required, :campyear %>
      <% end %>
    <% end %>

    <%= admin_panel 'Session Assignment', body_class: '' do %>
      <table class="admin-table">
        <thead><tr><th>ID</th><th>Session</th><th>Offer status</th></tr></thead>
        <tbody>
          <% @application.session_assignments.includes(:camp_occurrence).each do |assignment| %>
            <tr>
              <td><%= admin_legacy_link_to assignment.id, legacy_admin_session_assignment_path(assignment) %></td>
              <td><%= assignment.camp_occurrence.description %></td>
              <td><%= admin_status_badge(assignment.offer_status) %></td>
            </tr>
          <% end %>
          <% if @application.session_assignments.empty? %>
            <tr><td colspan="3"><%= admin_empty_state 'No session assignments.' %></td></tr>
          <% end %>
        </tbody>
      </table>
      <div class="border-t border-slate-200 px-4 py-2 text-xs text-slate-500">
        User selected sessions: <%= @application.session_registrations.map(&:description).join(', ').presence || '—' %>
      </div>
    <% end %>

    <%= admin_panel 'Course Assignment', body_class: '' do %>
      <table class="admin-table">
        <thead><tr><th>ID</th><th>Course</th><th>Session</th><th>Wait list</th></tr></thead>
        <tbody>
          <% @application.course_assignments.includes(course: :camp_occurrence).each do |assignment| %>
            <tr>
              <td><%= admin_legacy_link_to assignment.id, legacy_admin_course_assignment_path(assignment) %></td>
              <td><%= assignment.course.title %></td>
              <td><%= assignment.course.camp_occurrence.description %></td>
              <td><%= admin_boolean(assignment.wait_list) %></td>
            </tr>
          <% end %>
          <% if @application.course_assignments.empty? %>
            <tr><td colspan="4"><%= admin_empty_state 'No course assignments.' %></td></tr>
          <% end %>
        </tbody>
      </table>
      <h3 class="border-t border-slate-200 px-4 pt-3 pb-1 text-xs font-semibold tracking-wide text-slate-500 uppercase">User course preferences</h3>
      <table class="admin-table">
        <thead><tr><th>Course</th><th>Rank</th><th>Session</th><th>Available</th></tr></thead>
        <tbody>
          <% @application.course_preferences.includes(course: :camp_occurrence).order(:ranking).each do |preference| %>
            <tr>
              <td><%= preference.course.title %></td>
              <td><%= preference.ranking %></td>
              <td><%= preference.course.camp_occurrence.description %></td>
              <td><%= preference.course.remaining_spaces %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    <% end %>

    <%= admin_panel 'Activities / Services', body_class: '' do %>
      <table class="admin-table">
        <thead><tr><th>Assigned activity</th><th>Session</th></tr></thead>
        <tbody>
          <% @assigned_activities.each do |activity| %>
            <tr><td><%= activity.description %></td><td><%= activity.camp_occurrence.description %></td></tr>
          <% end %>
          <% if @assigned_activities.empty? %>
            <tr><td colspan="2"><%= admin_empty_state 'No assigned activities (requires an accepted session assignment).' %></td></tr>
          <% end %>
        </tbody>
      </table>
      <h3 class="border-t border-slate-200 px-4 pt-3 pb-1 text-xs font-semibold tracking-wide text-slate-500 uppercase">User selected activities</h3>
      <table class="admin-table">
        <thead><tr><th>Activity</th><th>Session</th></tr></thead>
        <tbody>
          <% @application.enrollment_activities.includes(activity: :camp_occurrence).each do |enrollment_activity| %>
            <tr><td><%= enrollment_activity.activity.description %></td><td><%= enrollment_activity.activity.camp_occurrence.description %></td></tr>
          <% end %>
        </tbody>
      </table>
    <% end %>

    <%= admin_panel "Finances — Balance Due: #{admin_money_from_cents(@payment_state.balance_due)} · Total Cost: #{admin_money_from_cents(@payment_state.total_cost)}",
                    body_class: '',
                    actions: safe_join([
                      button_to('Send Financial Aid Request Link', send_finaid_request_email_admin_application_path(@application), method: :post, class: 'admin-btn-link',
                                form: { data: { turbo_confirm: 'Email the financial aid request link to this applicant?' } }),
                      admin_legacy_link_to('Add Financial Aid Request', new_legacy_admin_financial_aid_request_path(enrollment_id: @application.id), class: 'admin-btn-link'),
                      admin_legacy_link_to('Add Manual Payment', new_legacy_admin_payment_path(enrollment_id: @application.id), class: 'admin-btn-link')
                    ]) do %>
      <% unless @application.application_fee_required %>
        <p class="border-b border-amber-200 bg-amber-50 px-4 py-2 text-sm font-semibold text-amber-900">
          This application was submitted after the Application Fee Requirement was turned off.
        </p>
      <% end %>
      <h3 class="px-4 pt-3 pb-1 text-xs font-semibold tracking-wide text-slate-500 uppercase">Payment activity</h3>
      <table class="admin-table">
        <thead><tr><th>ID</th><th>Account type</th><th>Date</th><th>Status</th><th>Amount</th></tr></thead>
        <tbody>
          <% @application.user.payments.current_camp_payments.each do |payment| %>
            <tr>
              <td><%= admin_legacy_link_to payment.id, legacy_admin_payment_path(payment) %></td>
              <td><%= payment.account_type.to_s.titleize %></td>
              <td><%= (Date.parse(payment.transaction_date) rescue payment.transaction_date) %></td>
              <td><%= transaction_status_message(payment.transaction_status) %></td>
              <td><%= admin_money_from_cents(payment.total_amount) %></td>
            </tr>
          <% end %>
          <% if @application.user.payments.current_camp_payments.empty? %>
            <tr><td colspan="5"><%= admin_empty_state 'No payments for the current camp.' %></td></tr>
          <% end %>
        </tbody>
      </table>
      <% if @application.financial_aids.any? %>
        <h3 class="border-t border-slate-200 px-4 pt-3 pb-1 text-xs font-semibold tracking-wide text-slate-500 uppercase">Financial aid requests</h3>
        <table class="admin-table">
          <thead><tr><th>Request</th><th>Amount</th><th>Status</th></tr></thead>
          <tbody>
            <% @application.financial_aids.each do |financial_aid| %>
              <tr>
                <td><%= admin_legacy_link_to 'view', legacy_admin_financial_aid_request_path(financial_aid) %></td>
                <td><%= humanized_money_with_symbol(financial_aid.amount) %></td>
                <td><%= admin_status_badge(financial_aid.status) %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      <% end %>
    <% end %>

    <%= admin_panel 'Recommendation', body_class: '' do %>
      <% if (recommendation = @application.recommendation) %>
        <table class="admin-table">
          <thead><tr><th>ID</th><th>First name</th><th>Last name</th><th>Organization</th><th>Letter</th></tr></thead>
          <tbody>
            <tr>
              <td><%= admin_legacy_link_to recommendation.id, legacy_admin_recommendation_path(recommendation) %></td>
              <td><%= recommendation.firstname %></td>
              <td><%= recommendation.lastname %></td>
              <td><%= recommendation.organization %></td>
              <td>
                <% if recommendation.recupload.present? %>
                  <%= admin_legacy_link_to 'view', legacy_admin_recupload_path(recommendation.recupload) %>
                <% else %>
                  <span class="text-slate-500">— waiting for response</span>
                <% end %>
              </td>
            </tr>
          </tbody>
        </table>
      <% else %>
        <%= admin_empty_state 'No recommendation requested.' %>
      <% end %>
    <% end %>

    <%= render 'admin/comments/comments', resource: @application %>
  </div>

  <div class="grid gap-5 self-start">
    <%= admin_panel 'Details', body_class: '' do %>
      <%= admin_attributes @application do |a| %>
        <% a.row :id %>
        <% a.row :transcript do |app| %><%= admin_attachment_link(app.transcript) %><% end %>
        <% a.row :camp_doc_form_completed, :international, :high_school_name, :high_school_address1, :high_school_address2,
                 :high_school_city, :high_school_state, :high_school_non_us, :high_school_postalcode, :high_school_country,
                 :year_in_school, :anticipated_graduation_year, :room_mate_request %>
      <% end %>
    <% end %>
  </div>
</div>
