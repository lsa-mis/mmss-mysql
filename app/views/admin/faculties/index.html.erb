<% admin_page_title 'Faculties', subtitle: "#{number_with_delimiter(@pagy.count)} #{'faculty account'.pluralize(@pagy.count)}" %>
<% admin_page_actions do %>
  <%= admin_csv_link %>
<% end %>

<%= admin_table @faculties, pagy: @pagy,
                batch_actions: Admin::FacultiesController::BATCH_ACTIONS, batch_url: batch_admin_faculties_path,
                actions: ->(faculty) { [admin_faculty_path(faculty), nil, admin_faculty_path(faculty)] } do |t| %>
  <% t.column :email, sort: true do |faculty| %>
    <%= link_to faculty.email, admin_faculty_path(faculty), class: 'font-medium' %>
  <% end %>
  <% t.column :current_sign_in_at, sort: true %>
  <% t.column :sign_in_count, sort: true %>
  <% t.column :created_at, sort: true %>
<% end %>
