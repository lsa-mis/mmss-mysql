<% admin_page_title 'Activities', subtitle: "#{number_with_delimiter(@pagy.count)} #{'activity'.pluralize(@pagy.count)}" %>
<% admin_page_actions do %>
  <%= admin_csv_link %>
  <%= link_to 'New Activity', new_admin_activity_path, class: 'admin-btn-primary' %>
<% end %>

<div class="grid gap-5 xl:grid-cols-4">
  <div class="xl:col-span-3">
    <%= admin_table @activities, pagy: @pagy,
                    batch_actions: Admin::ActivitiesController::BATCH_ACTIONS, batch_url: batch_admin_activities_path,
                    actions: ->(activity) { [admin_activity_path(activity), edit_admin_activity_path(activity), admin_activity_path(activity)] } do |t| %>
      <% t.column 'Session', sort: 'session' do |activity| %>
        <%= link_to activity.camp_occurrence.description, admin_session_configuration_path(activity.camp_occurrence) %>
      <% end %>
      <% t.column :description, sort: true do |activity| %>
        <%= link_to activity.description, admin_activity_path(activity), class: 'font-medium' %>
      <% end %>
      <% t.column 'Cost', sort: 'cost' do |activity| %>
        <%= humanized_money_with_symbol(activity.cost) %>
      <% end %>
      <% t.column :date_occurs, sort: true %>
      <% t.column :active, sort: true %>
      <% t.column :created_at, sort: true %>
      <% t.column :updated_at, sort: true %>
    <% end %>
  </div>

  <div class="xl:col-span-1">
    <%= admin_filter_form @filter, url: admin_activities_path %>
  </div>
</div>
