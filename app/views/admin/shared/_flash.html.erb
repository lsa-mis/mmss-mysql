<% flash.each do |type, message| %>
  <% next if message.blank? %>
  <div class="<%= class_names('mb-4 flex items-start justify-between gap-3 rounded-md border px-4 py-3 text-sm shadow-xs', admin_flash_class(type)) %>"
       role="<%= %w[alert error].include?(type.to_s) ? 'alert' : 'status' %>" id="flash-<%= type %>" data-controller="dismissable">
    <p><%= message %></p>
    <button type="button" class="text-current opacity-60 hover:opacity-100" aria-label="Dismiss" data-action="dismissable#dismiss">✕</button>
  </div>
<% end %>
