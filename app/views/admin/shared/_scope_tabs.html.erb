<%# locals: scopes, counts %>
<% grouped = scopes.group_by(&:group) %>
<div class="flex flex-wrap items-center gap-x-4 gap-y-2">
  <% grouped.each do |group, group_scopes| %>
    <div class="flex flex-wrap items-center gap-1 rounded-lg bg-white p-1 shadow-xs ring-1 ring-slate-200">
      <% if group %>
        <span class="px-2 text-[11px] font-semibold tracking-wide text-slate-400 uppercase"><%= group.to_s.humanize %></span>
      <% end %>
      <% group_scopes.each do |scope| %>
        <% active = current_scope == scope %>
        <%= link_to admin_scope_path(scope), class: class_names('admin-tab', 'admin-tab-active' => active), aria: { current: active ? 'page' : nil } do %>
          <%= scope.label %>
          <% if counts.key?(scope) %>
            <span class="admin-tab-count"><%= number_with_delimiter(counts[scope]) %></span>
          <% end %>
        <% end %>
      <% end %>
    </div>
  <% end %>
</div>
