<aside class="fixed inset-y-0 left-0 z-40 flex w-64 -translate-x-full transform flex-col bg-um-blue text-white transition-transform duration-200 lg:static lg:translate-x-0 lg:transition-none"
       data-admin-sidebar-target="panel" aria-label="Admin navigation">
  <div class="flex h-14 items-center gap-2 border-b border-white/10 px-4">
    <%= link_to admin_root_path, class: 'flex items-center gap-2 text-white hover:text-white' do %>
      <span class="inline-flex h-7 w-7 items-center justify-center rounded bg-um-maize text-xs font-bold text-um-blue">M</span>
      <span class="text-sm font-semibold tracking-wide">MMSS Admin</span>
    <% end %>
    <button type="button" class="ml-auto text-slate-300 hover:text-white lg:hidden" data-action="admin-sidebar#close" aria-label="Close navigation">✕</button>
  </div>

  <nav class="flex-1 overflow-y-auto px-2 pb-4">
    <% admin_menu_groups.each do |group| %>
      <% if group.label %>
        <div class="admin-nav-group"><%= group.label %></div>
      <% else %>
        <div class="pt-3"></div>
      <% end %>
      <ul class="space-y-0.5">
        <% group.items.each do |item| %>
          <li>
            <%= link_to admin_menu_item_path(item),
                        class: class_names('admin-nav-link', 'admin-nav-link-active' => admin_menu_item_active?(item)),
                        data: ({ turbo: false } if item.legacy?),
                        aria: { current: admin_menu_item_active?(item) ? 'page' : nil } do %>
              <span class="truncate"><%= item.label %></span>
              <% if item.legacy? %>
                <span class="ml-auto rounded bg-white/10 px-1 text-[10px] uppercase tracking-wide text-slate-300" title="Still served by ActiveAdmin">legacy</span>
              <% end %>
            <% end %>
          </li>
        <% end %>
      </ul>
    <% end %>
  </nav>

  <div class="border-t border-white/10 px-4 py-3 text-xs text-slate-300">
    <div class="truncate" title="<%= current_admin.email %>"><%= current_admin.email %></div>
    <%= link_to 'Back to site', root_path, class: 'text-slate-300 underline hover:text-white' %>
  </div>
</aside>
