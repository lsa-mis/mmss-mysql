<% admin_page_title "Course Assignment ##{@course_assignment.id}", subtitle: "#{admin_applicant_name(@course_assignment.enrollment)} · #{@course_assignment.course.title}" %>
<% admin_page_actions do %>
  <%= link_to 'Edit', edit_admin_course_assignment_path(@course_assignment), class: 'admin-btn-primary' %>
  <%= button_to 'Delete', admin_course_assignment_path(@course_assignment), method: :delete, class: 'admin-btn-danger',
                form: { data: { turbo_confirm: 'Delete this course assignment?' } } %>
<% end %>

<div class="grid gap-5 xl:grid-cols-3">
  <div class="grid gap-5 xl:col-span-2">
    <%= admin_panel 'Course Assignment', body_class: '' do %>
      <%= admin_attributes @course_assignment do |a| %>
        <% a.row 'Enrollment' do |assignment| %>
          <%= admin_applicant_link(assignment.enrollment) %>
          <span class="text-slate-500"><%= assignment.enrollment.user.email %></span>
        <% end %>
        <% a.row 'Course' do |assignment| %>
          <%= admin_resource_link(assignment.course) %>
        <% end %>
        <% a.row :wait_list, :created_at, :updated_at %>
      <% end %>
    <% end %>

    <%= render 'admin/comments/comments', resource: @course_assignment %>
  </div>
</div>
