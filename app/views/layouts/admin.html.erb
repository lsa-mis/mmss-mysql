<!DOCTYPE html>
<html lang="en" class="h-full">
  <head>
    <title><%= [content_for(:title).presence, 'MMSS Admin'].compact.join(' · ') %></title>
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= stylesheet_link_tag 'admin', media: 'all', 'data-turbo-track': 'reload' %>
    <%= javascript_importmap_tags %>
    <%= Sentry.get_trace_propagation_meta.html_safe %>
  </head>

  <body class="h-full"
        data-environment="<%= Rails.env %>"
        data-controller="session-timeout admin-sidebar"
        data-session-timeout-expires-at-value="<%= session_expires_at %>">
    <div data-session-timeout-target="warning" class="fixed inset-x-0 top-0 z-50 hidden bg-amber-400 px-4 py-3 text-amber-950 shadow-lg">
      <div class="mx-auto flex max-w-7xl items-center justify-between gap-4">
        <span class="text-sm font-semibold">Your session will expire soon. Save your work or refresh the page to extend it.</span>
        <button type="button" data-action="click->session-timeout#dismissWarning" class="text-sm font-medium hover:underline">Dismiss</button>
      </div>
    </div>

    <div class="flex min-h-full">
      <%# Mobile backdrop %>
      <div class="fixed inset-0 z-30 hidden bg-slate-900/50 lg:hidden" data-admin-sidebar-target="backdrop" data-action="click->admin-sidebar#close"></div>

      <%= render 'admin/shared/sidebar' %>

      <div class="flex min-w-0 flex-1 flex-col">
        <header class="sticky top-0 z-20 flex h-14 items-center gap-3 border-b border-slate-200 bg-white px-4 shadow-xs lg:px-6">
          <button type="button" class="admin-btn-secondary admin-btn-sm lg:hidden" data-action="admin-sidebar#open" aria-label="Open navigation">
            <span aria-hidden="true">☰</span>
          </button>

          <div class="min-w-0 flex-1">
            <h1 class="truncate text-base font-semibold text-slate-900 lg:text-lg"><%= content_for(:title).presence || 'Dashboard' %></h1>
            <% if content_for?(:subtitle) %>
              <p class="truncate text-xs text-slate-500"><%= yield :subtitle %></p>
            <% end %>
          </div>

          <div class="flex items-center gap-3">
            <span class="hidden text-sm text-slate-600 sm:inline" title="Signed in as"><%= current_admin.email %></span>
            <%= button_to 'Sign out', destroy_admin_session_path, method: :delete, class: 'admin-btn-secondary admin-btn-sm' %>
          </div>
        </header>

        <main class="flex-1 px-4 py-5 lg:px-6">
          <%= render 'admin/shared/flash' %>

          <% if content_for?(:page_actions) %>
            <div class="mb-4 flex flex-wrap items-center justify-end gap-2">
              <%= yield :page_actions %>
            </div>
          <% end %>

          <%= yield %>
        </main>

        <footer class="border-t border-slate-200 px-4 py-3 text-xs text-slate-500 lg:px-6">
          Michigan Math and Science Scholars · Admin · <%= link_to 'Legacy admin', legacy_admin_root_path, class: 'underline' %>
        </footer>
      </div>
    </div>
  </body>
</html>
