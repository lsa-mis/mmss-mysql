<!DOCTYPE html>
<html lang="en">
  <head>
    <title><%= flash[:alert].present? ? "Error — MMSS Application" : "MMSS Application" %></title>
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= stylesheet_link_tag 'tailwind', media: 'all', 'data-turbo-track': 'reload' %>
    <%= javascript_importmap_tags %>

    <noscript>
      <meta http-equiv="refresh" content="2;url=nojavascript.html">
    </noscript>
  </head>

  <body data-environment="<%= Rails.env %>">
    <%= render 'layouts/skip_link' %>
    <header class="w-full h-auto">
      <%= render 'layouts/nav_links_for_auth' %>
    </header>
    <main id="main-content" tabindex="-1" class="container mx-auto px-2">
      <%= render 'layouts/notifications' %>
      <div class="flex mb-4">
        <div class="h-auto">
          <%= yield %>
        </div>
      </div>
    </main>
    <footer class="w-full h-auto">
      <%= render '/layouts/footer' %>
    </footer>

  </body>
</html>
